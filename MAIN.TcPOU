<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="MAIN" Id="{d940760c-e873-4381-91d3-7b00ae51dd95}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	denemetontetik:BOOL:=FALSE;
	thedefsureton:TIME:=T#3S;
	bsonuccikis:BOOL;
	tgecen:TIME;
	tondeneme:tonnnnblock;
	
	//-----------------------
	denemetoftetik:BOOL:=FALSE;
	thedefsuretof:TIME:=T#4S;
	tofdeneme:toffffblock;
	//-----------------------
	tpdeneme:TPBLOCK;
	thedefsuretp:TIME:=T#5S;
	denemetptetik:BOOL:=FALSE;
	//------------------------
	tonrdeneme:tonrblock;
	denemetonrtetik:BOOL:=FALSE;
	denemetonrreset:BOOL:=FALSE;
	thedefsuretonr:TIME:=T#6S;
	//------------------------
	rtrigdeneme:fbrisetrig;
	denemertetik:BOOL:=FALSE;
	nrtrigsayac:INT:=0;
	//------------------------
	ftrigdeneme:fbfalltrig;
	denemeftetik:BOOL:=FALSE;
	nftrigsayac: INT :=0;
	

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[tondeneme(
	in:=denemetontetik,
	pt:=thedefsureton,
	out=>bsonuccikis,
	et=>tgecen
);

tofdeneme(
	in:=denemetoftetik,
	pt:=thedefsuretof
);	
tpdeneme(
	in:=denemetptetik,
	pt:=thedefsuretp
);

tonrdeneme(
	in:=denemetonrtetik,
	reset:=denemetonrreset,
	pt:=thedefsuretonr
);

rtrigdeneme(clkin:=denemertetik);
IF rtrigdeneme.clkout THEN
	nrtrigsayac:=nrtrigsayac +1;
END_IF

ftrigdeneme(clkin:=denemeftetik);
IF ftrigdeneme.clkout THEN
	nftrigsayac:=nftrigsayac+1;
END_IF
]]></ST>
    </Implementation>
